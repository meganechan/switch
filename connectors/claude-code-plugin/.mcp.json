{
  "mcpServers": {
    "switch": {
      "type": "http",
      "url": "${SWITCH_API_ENDPOINT}/mcp/",
      "headers": {
        "Authorization": "Bearer ${SWITCH_API_TOKEN}"
      }
    },
    "switch-channel": {
      "command": "sh",
      "args": [
        "-c",
        "cd \"$1\" && bun install --no-summary 1>&2 && exec bun server.ts",
        "switch-channel",
        "${CLAUDE_PLUGIN_ROOT}/channel"
      ],
      "env": {
        "SWITCH_API_ENDPOINT": "${SWITCH_API_ENDPOINT}",
        "SWITCH_API_TOKEN": "${SWITCH_API_TOKEN}",
        "SWITCH_AGENT_ID": "${SWITCH_AGENT_ID}"
      }
    }
  }
}
